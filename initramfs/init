#!/bin/busybox sh
# Experimental SM-T630 RAM-only bring-up. Never mounts/writes block devices.
export PATH=/bin:/sbin
export HOME=/root TERM=vt100
umask 077
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755,nosuid tmpfs /dev
mknod /dev/null c 1 3
mknod /dev/console c 5 1
mknod /dev/kmsg c 1 11
mknod /dev/tty c 5 0
chmod 666 /dev/null /dev/tty
mkdir -p /dev/pts
mount -t devpts devpts /dev/pts
mount -t tmpfs -o mode=0700,nosuid,nodev tmpfs /run
exec >/run/bringup.log 2>&1
echo 'SM-T630 bring-up v0.1: RAM only; no block-device mounts or writes.'
echo 'T630_BRINGUP: custom Linux /init reached' >/dev/kmsg
hostname t630-bringup
mdev -s

# Keep the system awake for this short diagnostic session, if supported.
[ ! -w /sys/power/wake_lock ] || echo t630_bringup >/sys/power/wake_lock

# Only standard USB CDC ACM; no network listeners, Android services or storage.
mount -t configfs configfs /config
g=/config/usb_gadget/t630_bringup
mkdir -p "$g"
echo 0x1d6b >"$g/idVendor"
echo 0x0104 >"$g/idProduct"
echo 0x0200 >"$g/bcdUSB"
echo 0x0100 >"$g/bcdDevice"
echo 0x02 >"$g/bDeviceClass"
mkdir -p "$g/strings/0x409"
echo T630BRINGUP001 >"$g/strings/0x409/serialnumber"
echo 'Local Linux bring-up' >"$g/strings/0x409/manufacturer"
echo 'SM-T630 RAM-only diagnostic console' >"$g/strings/0x409/product"
mkdir -p "$g/configs/c.1/strings/0x409"
echo 'USB serial console' >"$g/configs/c.1/strings/0x409/configuration"
echo 0x80 >"$g/configs/c.1/bmAttributes"
echo 100 >"$g/configs/c.1/MaxPower"
mkdir -p "$g/functions/acm.usb0"
ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"

# Stock sys.usb.controller was a600000.dwc3. Select only that controller.
attempt=0
while [ "$attempt" -lt 60 ]; do
    if [ -e /sys/class/udc/a600000.dwc3 ]; then
        if echo a600000.dwc3 >"$g/UDC"; then
            echo 'T630_BRINGUP: USB ACM bound' >/dev/kmsg
            break
        fi
    fi
    attempt=$((attempt + 1))
    sleep 1
done
mdev -s
uname -a >/run/uname.txt
cat /proc/cmdline >/run/cmdline.txt
cat /proc/partitions >/run/partitions.txt
dmesg >/run/dmesg.txt

# mdev hotplug helpers are disabled in this kernel; rescan for delayed nodes.
# PID 1 stays alive even if USB never appears. No automatic reboot loop.
while :; do
    mdev -s
    if [ -c /dev/ttyGS0 ]; then
        setsid getty -L -n -l /bin/usb-shell 115200 ttyGS0 vt100
    fi
    sleep 2
done
