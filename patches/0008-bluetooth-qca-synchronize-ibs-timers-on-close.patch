--- a/drivers/bluetooth/hci_qca.c
+++ b/drivers/bluetooth/hci_qca.c
@@ -610,11 +610,23 @@ static int qca_close(struct hci_uart *hu)
 
 	serial_clock_vote(HCI_IBS_VOTE_STATS_UPDATE, hu);
 
+	/*
+	 * The timer callbacks dereference qca.  del_timer() does not wait for a
+	 * callback already running on another CPU, so changing the line
+	 * discipline can otherwise free qca underneath that callback.  Drain the
+	 * timers before the workqueue and again afterwards: queued work can rearm
+	 * an IBS timer while destroy_workqueue() is flushing it.  Newer kernels
+	 * use timer_shutdown_sync() for the same guarantee, but it is not
+	 * available in this 5.4 tree.
+	 */
+	del_timer_sync(&qca->tx_idle_timer);
+	del_timer_sync(&qca->wake_retrans_timer);
+	destroy_workqueue(qca->workqueue);
+	del_timer_sync(&qca->tx_idle_timer);
+	del_timer_sync(&qca->wake_retrans_timer);
+
 	skb_queue_purge(&qca->tx_wait_q);
 	skb_queue_purge(&qca->txq);
-	del_timer(&qca->tx_idle_timer);
-	del_timer(&qca->wake_retrans_timer);
-	destroy_workqueue(qca->workqueue);
 	qca->hu = NULL;
 
 	if (hu->serdev) {
