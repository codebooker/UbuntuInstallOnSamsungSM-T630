 	char *firmware_path = NULL;
@@ -290,6 +292,43 @@ static int pd_enumerate_jsons(struct assoc *json_set)
 	size_t len;
 	size_t n;
 
+	if (map_directory) {
+		if (stat(map_directory, &directory_stat) < 0 ||
