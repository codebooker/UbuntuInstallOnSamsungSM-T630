Use the Qualcomm downstream FastRPC ioctl ABI found in Samsung's 5.4 kernel.

The SM-T630 exposes /dev/adsprpc-smd from the older downstream driver. Its
ioctl numbers and argument layout predate the upstream /dev/fastrpc-* ABI.

diff --git a/include/libhexagonrpc/fastrpc-legacy.h b/include/libhexagonrpc/fastrpc-legacy.h
new file mode 100644
index 0000000..172a52e
--- /dev/null
+++ b/include/libhexagonrpc/fastrpc-legacy.h
@@ -0,0 +1,58 @@
+#ifndef LIBHEXAGONRPC_FASTRPC_LEGACY_H
+#define LIBHEXAGONRPC_FASTRPC_LEGACY_H
+
+#include <stddef.h>
+#include <stdint.h>
+#include <sys/ioctl.h>
+
+struct fastrpc_legacy_remote_buf {
+	void *pv;
+	size_t len;
+};
+
+struct fastrpc_legacy_remote_dma_handle {
+	int fd;
+	uint32_t offset;
+};
+
+union fastrpc_legacy_remote_arg {
+	struct fastrpc_legacy_remote_buf buf;
+	struct fastrpc_legacy_remote_dma_handle dma;
+	uint32_t h;
+};
+
+struct fastrpc_legacy_invoke {
+	uint32_t handle;
+	uint32_t sc;
+	union fastrpc_legacy_remote_arg *pra;
+};
+
+struct fastrpc_legacy_init {
+	uint32_t flags;
+	uintptr_t file;
+	uint32_t filelen;
+	int32_t filefd;
+	uintptr_t mem;
+	uint32_t memlen;
+	int32_t memfd;
+};
+
+struct fastrpc_legacy_mmap {
+	int fd;
+	uint32_t flags;
+	uintptr_t vaddrin;
+	size_t size;
+	uintptr_t vaddrout;
+};
+
+#define FASTRPC_LEGACY_INIT_ATTACH 0
+#define FASTRPC_LEGACY_INIT_ATTACH_SENSORS 3
+
+#define FASTRPC_LEGACY_IOCTL_INVOKE \
+	_IOWR('R', 1, struct fastrpc_legacy_invoke)
+#define FASTRPC_LEGACY_IOCTL_MMAP \
+	_IOWR('R', 2, struct fastrpc_legacy_mmap)
+#define FASTRPC_LEGACY_IOCTL_INIT \
+	_IOWR('R', 6, struct fastrpc_legacy_init)
+#define FASTRPC_LEGACY_IOCTL_GETINFO \
+	_IOWR('R', 8, uint32_t)
+
+#endif
