   gtk_widget_show_all (GTK_WIDGET (authenticator->dialog));
-  gtk_window_present_with_time (GTK_WINDOW (authenticator->dialog),
-                                gdk_x11_get_server_time (gtk_widget_get_window (GTK_WIDGET (authenticator->dialog))));
