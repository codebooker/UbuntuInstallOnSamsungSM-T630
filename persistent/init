#!/bin/busybox sh
# SM-T630 only. Mounts the explicitly provisioned Ubuntu userdata filesystem.
# Never formats storage or changes a partition table during boot.
export PATH=/bin:/sbin HOME=/root TERM=xterm-256color
umask 022
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755,nosuid tmpfs /dev
mknod /dev/null c 1 3
mknod /dev/console c 5 1
mknod /dev/kmsg c 1 11
mknod /dev/tty c 5 0
chmod 666 /dev/null /dev/tty
mkdir -p /dev/pts
mount -t devpts -o mode=0620,ptmxmode=0666 devpts /dev/pts
mount -t tmpfs -o mode=0755,nosuid,nodev,size=256m tmpfs /run
exec >/run/bringup.log 2>&1
hostname ubuntablet
mdev -s
echo 'T630_PERSISTENT: init reached; USB fallback starts before Ubuntu' >/dev/kmsg
[ -r /proc/cmdline ]
case " $(cat /proc/cmdline) " in
    *' androidboot.mode=charger '*|*' sec_mparam.lpcharge=1 '*)
        charger_boot=1
        ;;
    *)
        charger_boot=0
        ;;
esac
[ ! -w /sys/power/wake_lock ] || echo t630_bringup >/sys/power/wake_lock
mount -t configfs configfs /config
g=/config/usb_gadget/t630_bringup
mkdir -p "$g"
echo 0x1d6b >"$g/idVendor"
echo 0x0104 >"$g/idProduct"
echo 0x0200 >"$g/bcdUSB"
echo 0x0100 >"$g/bcdDevice"
echo 0x02 >"$g/bDeviceClass"
mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409"
echo T630BRINGUP001 >"$g/strings/0x409/serialnumber"
echo 'Local Linux bring-up' >"$g/strings/0x409/manufacturer"
echo 'SM-T630 Ubuntu recovery console' >"$g/strings/0x409/product"
echo 'USB serial console' >"$g/configs/c.1/strings/0x409/configuration"
echo 0x80 >"$g/configs/c.1/bmAttributes"
echo 100 >"$g/configs/c.1/MaxPower"
mkdir -p "$g/functions/acm.usb0"
ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"
attempt=0
while [ "$attempt" -lt 60 ]; do
    if [ -e /sys/class/udc/a600000.dwc3 ] && echo a600000.dwc3 >"$g/UDC"; then
        break
    fi
    attempt=$((attempt + 1))
    sleep 1
done
mdev -s
# Samsung charger/LPM boot skips cfg80211 regulatory initialization.  Starting
# the WLAN stack in that state reproducibly panics handle_reg_beacon on the
# first scan.  A clean reboot leaves charger mode and performs a normal boot;
# do this before start-ubuntu can consume the one-shot release-root selector.
if [ "$charger_boot" = 1 ]; then
    echo 'T630_PERSISTENT: charger/LPM boot detected; rebooting before Ubuntu' >/dev/kmsg
    sync
    /bin/busybox reboot -f
    while :; do sleep 1; done
fi
/bin/busybox sh /bin/start-ubuntu >/run/ubuntu-start.log 2>&1 &
while :; do
    mdev -s
    if [ -c /dev/ttyGS0 ]; then
        setsid getty -L -n -l /bin/usb-shell 115200 ttyGS0 xterm-256color
    fi
    sleep 2
done
