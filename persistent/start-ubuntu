#!/bin/busybox sh
set -eu
export PATH=/bin:/sbin
hostroot=/run/ubuntu
root=$hostroot
selector=$hostroot/.t630-next-root
consumed=$hostroot/.t630-next-root.consumed
test "$(uname -r)" = '5.4.274-qgki-31225846-abT630XXSBDZE3'
attempt=0
while [ ! -b /dev/sda34 ] && [ "$attempt" -lt 60 ]; do
    mdev -s
    sleep 1
    attempt=$((attempt + 1))
done
partition_name=$(sed -n 's/^PARTNAME=//p' /sys/class/block/sda34/uevent)
partition_size=$(cat /sys/class/block/sda34/size)
case "$partition_name:$partition_size" in
    userdata:226918360|linuxroot:134217728) ;;
    *) echo "Unexpected Ubuntu root geometry: $partition_name:$partition_size" >&2; exit 1 ;;
esac
# Refuse any unexpected or unprovisioned filesystem, without repair or format.
# This minimal BusyBox has no blkid. Read only the ext superblock's magic and
# UUID bytes; mounting below performs the actual filesystem validation.
test "$(dd if=/dev/sda34 bs=1 skip=1080 count=2 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 53ef
test "$(dd if=/dev/sda34 bs=1 skip=1128 count=16 2>/dev/null | od -An -tx1 | tr -d ' \n')" = 64de854453ea4fdc8946d6b07e238630
mkdir -p "$hostroot"
mount -t ext4 -o noatime,errors=remount-ro /dev/sda34 "$hostroot"
test "$(cat "$hostroot/etc/t630-install-id")" = 'SM-T630-T630XXSBDZE3-Ubuntu-v1'
boot_journal=$hostroot/.t630-last-boot
previous_boot_journal=$hostroot/.t630-previous-boot
boot_journal_temp=$hostroot/.t630-last-boot.tmp
for path in "$boot_journal" "$previous_boot_journal"; do
    if [ -e "$path" ]; then
        test -f "$path"
        test ! -L "$path"
    fi
done
if [ -e "$boot_journal_temp" ]; then
    test -f "$boot_journal_temp"
    test ! -L "$boot_journal_temp"
    rm "$boot_journal_temp"
fi
if [ -e "$boot_journal" ]; then
    mv -f "$boot_journal" "$previous_boot_journal"
fi
boot_stage() {
    stage=$1
    (
        umask 077
        printf 'root=%s\nstage=%s\n' "$root" "$stage" >"$boot_journal_temp"
        mv "$boot_journal_temp" "$boot_journal"
        sync
    )
}
boot_stage userdata-mounted
# A guarded rehearsal may select the fixed, preserved clean root for one boot.
# Consume the selector before entering the candidate so any later failure falls
# back to the known-good filesystem root at the next hardware restart.
if [ -e "$selector" ]; then
    test -f "$selector"
    test ! -L "$selector"
    test "$(cat "$selector")" = 'opt/t630/rehearsal/release-root'
    candidate=$hostroot/opt/t630/rehearsal/release-root
    test -d "$candidate"
    test ! -L "$candidate"
    test -f "$candidate/.t630-offline-root"
    test ! -L "$candidate/.t630-offline-root"
    test "$(cat "$candidate/.t630-offline-root")" = 'SM-T630 OFFLINE RELEASE ROOT'
    test "$(cat "$candidate/etc/t630-install-id")" = 'SM-T630-T630XXSBDZE3-Ubuntu-v1'
    mv "$selector" "$consumed"
    sync
    root=$candidate
    boot_stage selector-consumed
    echo 'T630_PERSISTENT: consumed clean-root one-shot selector' >/dev/kmsg
fi
printf '%s\n' "$root" >/run/t630-selected-root
mkdir -p "$root/dev" "$root/proc" "$root/sys" "$root/run" "$root/tmp"
chmod 755 "$root" "$root/run"
chmod 1777 "$root/tmp"
mount --bind /dev "$root/dev"
mount --bind /dev/pts "$root/dev/pts"
mount --bind /proc "$root/proc"
mount --bind /sys "$root/sys"
mount -t tmpfs -o mode=0755,nosuid,nodev,size=128m tmpfs "$root/run"
mkdir -p "$root/dev/shm"
mount -t tmpfs -o mode=1777,nosuid,nodev,size=256m tmpfs "$root/dev/shm"
boot_stage runtime-mounts-ready
mkdir -p "$root/run/user/0" "$root/run/dbus" "$root/run/udev" "$root/var/log/chrony"
chmod 700 "$root/run/user/0"
chmod 755 "$root/run/dbus" "$root/run/udev"
ln -s "$root/opt/t630/vendor" /vendor
mkdir -p /run/input-firmware
for name in tsp_stm w9019_gtact4pro.bin qca6490 wlan; do
    ln -s "$root/opt/t630/vendor/firmware/$name" "/run/input-firmware/$name"
done
printf '%s' /run/input-firmware >/sys/module/firmware_class/parameters/path
for name in sec_tsp_log sec_cmd sec_common_fn sec_secure_touch sec_tclm_v2 sec_tsp_dumpkey stm_ts_fts1b90a w9019; do
    [ -d "/sys/module/$name" ] || insmod "$root/opt/t630/vendor/lib/modules/$name.ko"
done
mdev -s
# Ensure conventional DRM paths exist before udev enumerates this old kernel.
mkdir -p /dev/dri
for name in card0 renderD128; do
    if [ ! -c "/dev/dri/$name" ]; then
        numbers=$(cat "/sys/class/drm/$name/dev")
        mknod "/dev/dri/$name" c "${numbers%:*}" "${numbers#*:}"
    fi
done
chroot "$root" /usr/lib/systemd/systemd-udevd --daemon
chroot "$root" /usr/bin/env SYSTEMD_IGNORE_CHROOT=1 /usr/bin/udevadm trigger --action=add --subsystem-match=drm
chroot "$root" /usr/bin/env SYSTEMD_IGNORE_CHROOT=1 /usr/bin/udevadm trigger --action=add --subsystem-match=input
chroot "$root" /usr/bin/env SYSTEMD_IGNORE_CHROOT=1 /usr/bin/udevadm trigger --action=add --subsystem-match=net
chroot "$root" /usr/bin/udevadm settle --timeout=10 || true
boot_stage udev-ready
# Supervise only this prototype's services; a stop marker prevents respawn.
service() {
    name=$1
    shift
    (
        while [ ! -e /run/t630-stopping ]; do
            chroot "$root" "$@" >>"/run/$name.log" 2>&1 || true
            sleep 2
        done
    ) &
}
service dbus /usr/bin/dbus-daemon --system --nofork --nopidfile
attempt=0
while [ ! -S "$root/run/dbus/system_bus_socket" ] && [ "$attempt" -lt 20 ]; do
    sleep 1
    attempt=$((attempt + 1))
done
service seatd /usr/bin/env SEATD_VTBOUND=0 /usr/sbin/seatd -l info
service wpa /usr/sbin/wpa_supplicant -u -s
service network /usr/sbin/NetworkManager --no-daemon --log-level=INFO
service clock /usr/sbin/chronyd -d -f /etc/chrony/t630.conf
# NetworkManager normally asks systemd to activate nm-dispatcher. PID 1 in this
# recovery-hosted port is BusyBox, so provide a one-shot cold-boot fallback for
# the optional lab remote runtime. Its own lock keeps this safe alongside a
# dispatcher event, and release images without the helper do nothing here.
(
    attempt=0
    while [ "$attempt" -lt 60 ]; do
        if [ -x "$root/usr/local/sbin/t630-remote-start" ] &&
           chroot "$root" /usr/bin/nmcli -t -f TYPE,STATE device status 2>/dev/null |
               grep -qx 'wifi:connected'; then
            chroot "$root" /usr/local/sbin/t630-remote-start
            exit $?
        fi
        attempt=$((attempt + 1))
        sleep 2
    done
    echo 'Connected Wi-Fi did not appear; optional remote startup skipped.'
) >/run/remote-start.log 2>&1 &
# Qualcomm firmware init can take time. It must not block the desktop/fallback.
(
    for name in cnss_prealloc cnss_nl cnss_utils device_management_service_v01 wlan_firmware_service_v01 cnss2; do
        [ -d "/sys/module/$name" ] || insmod "$root/opt/t630/vendor/lib/modules/$name.ko"
    done
    # Do not send CNSS's filesystem-ready event.  On this stock Samsung kernel,
    # three reproduced cold boots using the shortcut panicked in
    # handle_reg_beacon on the first scan.  The driver's own bounded timeout is
    # slower but preserves the calibration/regulatory initialization sequence.
    echo "CNSS_FILESYSTEM_READY_DEFERRED; retaining proven timeout fallback"
    [ -d /sys/module/wlan ] ||
        insmod "$root/opt/t630/vendor/lib/modules/qca_cld3_wlan.ko"
    mdev -s
    echo "WLAN_MODULE_LOAD_RETURNED uptime=$(cut -d ' ' -f 1 /proc/uptime)"
) >/run/wifi-load.log 2>&1 &
attempt=0
while [ ! -S "$root/run/seatd.sock" ] && [ "$attempt" -lt 20 ]; do
    sleep 1
    attempt=$((attempt + 1))
done
boot_stage core-services-ready
service weston /usr/bin/env HOME=/root TERM=xterm-256color XDG_RUNTIME_DIR=/run/user/0 LIBSEAT_BACKEND=seatd LD_PRELOAD=/usr/local/lib/t630-drm-compat.so WESTON_DISABLE_GBM_MODIFIERS=1 /usr/bin/weston --backend=drm-backend.so --renderer=pixman --config=/usr/local/share/t630/weston.ini --log=/run/weston.log --socket=wayland-0
attempt=0
while [ ! -S "$root/run/user/0/wayland-0" ] && [ "$attempt" -lt 30 ]; do
    sleep 1
    attempt=$((attempt + 1))
done
boot_stage weston-ready
# Keep the visible terminal as an ownerless/recovery facility. A personalized
# installation already has the independent USB serial console, and showing a
# root terminal before its password lock is both confusing and unnecessary.
if [ ! -f "$root/etc/t630/owner" ] ||
   { [ -f "$root/etc/t630/recovery-terminal.enabled" ] &&
     [ ! -L "$root/etc/t630/recovery-terminal.enabled" ]; }; then
    : >"$root/run/t630-recovery-terminal"
    chroot "$root" /usr/bin/env HOME=/root TERM=xterm-256color \
        XDG_RUNTIME_DIR=/run/user/0 WAYLAND_DISPLAY=wayland-0 \
        /usr/bin/weston-terminal --font-size=20 --shell=/bin/bash \
        >/run/terminal.log 2>&1 &
fi
boot_stage startup-dispatched
echo 'T630_PERSISTENT: Ubuntu startup dispatched'
wait
