// The hand-built GNOME session is registered with elogind rather than GDM.
// Permit only the installer-selected owner group to consume read-only sensors.
polkit.addRule(function(action, subject) {
    if (action.id == "net.hadess.SensorProxy.claim-sensor" &&
        subject.isInGroup("t630-owner")) {
        return polkit.Result.YES;
    }
});
