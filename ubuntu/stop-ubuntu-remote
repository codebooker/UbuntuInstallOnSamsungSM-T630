#!/bin/busybox sh
# Stop prototype services before unmounting. Never force an unclean restart.
set -eu
test "${1:-}" = reboot
# An SSH-side redirect may have opened /dev/null through Ubuntu's bind mount.
# Reopen it after entering the outer root so this helper cannot pin that mount.
cd /
exec </dev/null
touch /run/t630-stopping
owner_name=$(cat /run/ubuntu/etc/t630/owner)
case "$owner_name" in
    ''|*[!a-z0-9_-]*) echo 'Invalid installed owner; refusing restart.'; exit 1 ;;
esac
owner_uid=$(chroot /run/ubuntu /usr/bin/id -u "$owner_name")
test "$owner_uid" -ge 1000
for name in sshd t630-screen gdm gdm3 elogind weston-terminal weston weston-keyboard NetworkManager wpa_supplicant chronyd seatd systemd-udevd dbus-daemon; do
    chroot /run/ubuntu /usr/bin/pkill -TERM -x "$name" || true
done
# Desktop apps can be launched after boot. Stop only processes rooted in this
# exact Ubuntu mount; leave the outer recovery shell and PID 1 untouched.
for proc in /proc/[0-9]*; do
    if [ "$(readlink "$proc/root" 2>/dev/null || true)" = /run/ubuntu ]; then
        kill -TERM "${proc##*/}" 2>/dev/null || true
    fi
done
attempt=0
while :; do
    remaining=0
    for proc in /proc/[0-9]*; do
        if [ "$(readlink "$proc/root" 2>/dev/null || true)" = /run/ubuntu ]; then
            remaining=1
        fi
    done
    [ "$remaining" = 1 ] || break
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        echo 'Ubuntu processes are still exiting; refusing forced restart.'
        exit 1
    fi
    sleep 1
done
sync
# Camera development adds read-only Android compatibility mounts inside the
# Ubuntu root. Tear those down from deepest to shallowest before unmounting
# Ubuntu itself; never use lazy or forced unmounts here.
for target in /run/ubuntu/system/bin/cameraserver /run/ubuntu/mnt/stock-vendor-full/lib64/hw/com.qti.chi.override.so /run/ubuntu/apex/com.samsung.android.camera.unihal /run/ubuntu/apex/com.android.i18n /run/ubuntu/apex/com.android.runtime /run/ubuntu/dev/t630-vndk30 /run/ubuntu/dev/binderfs /run/ubuntu/linkerconfig /run/ubuntu/vendor /run/ubuntu/system /run/ubuntu/data /run/ubuntu/mnt/t630-camera /run/ubuntu/mnt/t630-i18n /run/ubuntu/mnt/t630-runtime /run/ubuntu/mnt/t630-vndk30 /run/ubuntu/mnt/stock-vendor-full /run/ubuntu/mnt/t630-persist /run/ubuntu/mnt/t630-efs /run/ubuntu/mnt/t630-sec_efs /run/ubuntu/mnt/t630-prism /run/ubuntu/mnt/t630-optics /run/ubuntu/mnt/t630-stock-system; do
    attempt=0
    while grep -q " $target " /proc/mounts; do
        if umount "$target"; then break; fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 10 ]; then
            echo "Camera mount still busy: $target; refusing forced restart."
            exit 1
        fi
        sleep 1
    done
done
if [ -r /sys/class/block/dm-0/dm/name ] &&
   [ "$(cat /sys/class/block/dm-0/dm/name)" = t630-stock-system ]; then
    chroot /run/ubuntu /usr/sbin/dmsetup remove t630-stock-system
fi
for target in "/run/ubuntu/run/user/$owner_uid/doc" "/run/ubuntu/run/user/$owner_uid/gvfs" \
              /run/ubuntu/run/user/105/doc /run/ubuntu/run/user/105/gvfs \
              "/run/ubuntu/run/user/$owner_uid" /run/ubuntu/run/user/105 \
              /run/ubuntu/sys/fs/cgroup/elogind /run/ubuntu/sys/fs/cgroup \
              /run/ubuntu/dev/shm /run/ubuntu/dev/pts /run/ubuntu/dev \
              /run/ubuntu/proc /run/ubuntu/sys /run/ubuntu/run /run/ubuntu; do
    attempt=0
    while grep -q " $target " /proc/mounts; do
        if umount "$target"; then break; fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 30 ]; then
            echo "Mount still busy: $target; refusing forced restart."
            exit 1
        fi
        sleep 1
    done
done
sync
# This script finishes in the outer recovery root, but an SSH invocation can
# retain Ubuntu's PATH. Name BusyBox explicitly so we never resolve systemd's
# chroot-aware reboot wrapper and silently leave the tablet running unmounted.
/bin/busybox reboot -f
