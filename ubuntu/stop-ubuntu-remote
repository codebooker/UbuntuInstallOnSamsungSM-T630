#!/bin/busybox sh
# Stop prototype services before unmounting. Never force an unclean restart.
set -eu
action=${1:-}
case "$action" in
    reboot|poweroff) ;;
    *) echo 'Expected reboot or poweroff.' >&2; exit 2 ;;
esac
# An SSH-side redirect may have opened /dev/null through Ubuntu's bind mount.
# Reopen it after entering the outer root so this helper cannot pin that mount.
cd /
exec </dev/null
touch /run/t630-stopping
root=$(cat /run/t630-selected-root 2>/dev/null || echo /run/ubuntu)
case "$root" in
    /run/ubuntu|/run/ubuntu/opt/t630/rehearsal/release-root) ;;
    *) echo 'Invalid selected Ubuntu root; refusing system action.'; exit 1 ;;
esac
test -d "$root"
test ! -L "$root"
journal=/run/ubuntu/.t630-last-system-action
journal_temp=/run/ubuntu/.t630-last-system-action.tmp
if [ -e "$journal" ]; then
    test -f "$journal"
    test ! -L "$journal"
fi
test ! -e "$journal_temp"
system_action_stage() {
    stage=$1
    (
        umask 077
        printf 'action=%s\nroot=%s\nstage=%s\n' "$action" "$root" "$stage" \
            >"$journal_temp"
        mv "$journal_temp" "$journal"
        sync
    )
}
system_action_stage starting
owner_uid=65534
if [ -f "$root/etc/t630/owner" ]; then
    owner_name=$(cat "$root/etc/t630/owner")
    case "$owner_name" in
        ''|*[!a-z0-9_-]*) echo 'Invalid installed owner; refusing restart.'; exit 1 ;;
    esac
    owner_uid=$(chroot "$root" /usr/bin/id -u "$owner_name")
    test "$owner_uid" -ge 1000
else
    # The one-shot clean root must remain recoverable if account setup has not
    # completed. Never permit this ownerless exception for the normal root.
    test "$root" = /run/ubuntu/opt/t630/rehearsal/release-root
    test "$(cat "$root/.t630-offline-root")" = 'SM-T630 OFFLINE RELEASE ROOT'
fi
# Waydroid's LXC monitor enters the outer root in a private mount namespace,
# so it is intentionally not caught by the ordinary "process rooted in
# Ubuntu" sweep below. Ask both Waydroid coordinators to exit first, then
# require LXC to reach STOPPED; never leave Android alive across an Ubuntu
# unmount.
for proc in /proc/[0-9]*; do
    [ "$(readlink "$proc/root" 2>/dev/null || true)" = "$root" ] || continue
    command=$(tr '\0' ' ' <"$proc/cmdline" 2>/dev/null || true)
    case "$command" in
        '/usr/bin/python3 /usr/bin/waydroid --details-to-stdout container start '|\
        '/usr/bin/python3 /usr/bin/waydroid --details-to-stdout session start ')
            kill -TERM "${proc##*/}" 2>/dev/null || true
            ;;
    esac
done
if [ -x "$root/usr/bin/lxc-info" ]; then
    attempt=0
    while [ "$(chroot "$root" /usr/bin/lxc-info -P /var/lib/waydroid/lxc -n waydroid -sH 2>/dev/null || true)" = RUNNING ]; do
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 20 ]; then
            chroot "$root" /usr/bin/lxc-stop -P /var/lib/waydroid/lxc -n waydroid -t 20
            break
        fi
        sleep 1
    done
    test "$(chroot "$root" /usr/bin/lxc-info -P /var/lib/waydroid/lxc -n waydroid -sH 2>/dev/null || true)" != RUNNING
fi
for name in sshd t630-screen gdm gdm3 elogind weston-terminal weston weston-keyboard NetworkManager wpa_supplicant chronyd seatd systemd-udevd dbus-daemon; do
    chroot "$root" /usr/bin/pkill -TERM -x "$name" || true
done
# Desktop apps can be launched after boot. Stop only processes rooted in this
# exact Ubuntu mount; leave the outer recovery shell and PID 1 untouched.
for proc in /proc/[0-9]*; do
    if [ "$(readlink "$proc/root" 2>/dev/null || true)" = "$root" ]; then
        kill -TERM "${proc##*/}" 2>/dev/null || true
    fi
done
attempt=0
while :; do
    remaining=0
    for proc in /proc/[0-9]*; do
        if [ "$(readlink "$proc/root" 2>/dev/null || true)" = "$root" ]; then
            remaining=1
        fi
    done
    [ "$remaining" = 1 ] || break
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 30 ]; then
        echo 'Ubuntu processes are still exiting; refusing forced restart.'
        exit 1
    fi
    sleep 1
done
sync
# Waydroid normally removes these when its container coordinator exits. The
# explicit loops make shutdown deterministic after an interrupted or failed
# Android launch as well.
for suffix in /var/lib/waydroid/rootfs/vendor/waydroid.prop \
              /var/lib/waydroid/rootfs/vendor \
              /var/lib/waydroid/rootfs; do
    target=$root$suffix
    attempt=0
    while grep -q " $target " /proc/mounts; do
        if umount "$target"; then continue; fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 10 ]; then
            echo "Waydroid mount still busy: $target; refusing forced restart."
            exit 1
        fi
        sleep 1
    done
done
# Camera development adds read-only Android compatibility mounts inside the
# Ubuntu root. Tear those down from deepest to shallowest before unmounting
# Ubuntu itself; never use lazy or forced unmounts here.
for suffix in /system/bin/cameraserver /mnt/stock-vendor-full/lib64/hw/com.qti.chi.override.so /apex/com.samsung.android.camera.unihal /apex/com.android.i18n /apex/com.android.runtime /dev/t630-vndk30 /dev/binderfs /linkerconfig /vendor /system /data /mnt/t630-camera /mnt/t630-i18n /mnt/t630-runtime /mnt/t630-vndk30 /mnt/stock-vendor-full /mnt/t630-persist /mnt/t630-efs /mnt/t630-sec_efs /mnt/t630-prism /mnt/t630-optics /mnt/t630-stock-system; do
    target=$root$suffix
    attempt=0
    while grep -q " $target " /proc/mounts; do
        if umount "$target"; then break; fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 10 ]; then
            echo "Camera mount still busy: $target; refusing forced restart."
            exit 1
        fi
        sleep 1
    done
done
for mapping in t630-stock-vendor t630-stock-system; do
    if chroot "$root" /usr/sbin/dmsetup info "$mapping" >/dev/null 2>&1; then
        chroot "$root" /usr/sbin/dmsetup remove "$mapping"
    fi
done
for suffix in "/run/user/$owner_uid/doc" "/run/user/$owner_uid/gvfs" \
              /run/user/105/doc /run/user/105/gvfs \
              "/run/user/$owner_uid" /run/user/105 \
              /sys/fs/cgroup/pids /sys/fs/cgroup/freezer \
              /sys/fs/cgroup/devices /sys/fs/cgroup/memory \
              /sys/fs/cgroup/blkio /sys/fs/cgroup/cpu_cpuacct \
              /sys/fs/cgroup/cpuset /sys/fs/cgroup/elogind \
              /sys/fs/cgroup /dev/binderfs \
              /dev/shm /dev/pts /dev /proc /sys /run; do
    target=$root$suffix
    attempt=0
    while grep -q " $target " /proc/mounts; do
        if umount "$target"; then break; fi
        attempt=$((attempt + 1))
        if [ "$attempt" -ge 30 ]; then
            echo "Mount still busy: $target; refusing forced restart."
            exit 1
        fi
        sleep 1
    done
done
if [ "$root" != /run/ubuntu ]; then
    test -z "$(grep " $root/" /proc/mounts || true)"
    # An orderly action from the personalized clean root should return to that
    # same installation. Preserve the one-shot selector's crash fallback: it
    # remains consumed throughout runtime and is rearmed only after every
    # process and nested mount has shut down successfully.
    selector=/run/ubuntu/.t630-next-root
    consumed=/run/ubuntu/.t630-next-root.consumed
    if [ -e "$selector" ]; then
        test -f "$selector"
        test ! -L "$selector"
        test "$(cat "$selector")" = opt/t630/rehearsal/release-root
    else
        test -f "$consumed"
        test ! -L "$consumed"
        test "$(cat "$consumed")" = opt/t630/rehearsal/release-root
        mv "$consumed" "$selector"
    fi
    sync
fi
system_action_stage ready-to-unmount
umount /run/ubuntu
sync
# This script finishes in the outer recovery root, but a desktop or SSH
# invocation can retain Ubuntu's PATH. Name BusyBox and the validated action
# explicitly so we never resolve a chroot-aware systemd wrapper.
/bin/busybox "$action" -f
