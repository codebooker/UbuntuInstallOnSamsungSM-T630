#!/bin/bash
# Start the hardware bridge on demand, run GNOME Camera, and release it on exit.
set -euo pipefail

test "$(id -u)" = 1000
camera=${1:-front}
case "$camera" in
    front|rear) ;;
    *) echo "usage: $0 [front|rear]" >&2; exit 2 ;;
esac
sudo -n /usr/local/sbin/t630-camera-control "$camera"
cleanup() {
    sudo -n /usr/local/sbin/t630-camera-control disable || true
}
trap cleanup EXIT INT TERM
snapshot
