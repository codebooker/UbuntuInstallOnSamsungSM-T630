#!/bin/bash
# Publish one Samsung camera as a normal PipeWire video source.
set -euo pipefail

test "$(id -u)" = 0
test "$(cat /etc/t630-install-id)" = SM-T630-T630XXSBDZE3-Ubuntu-v1
test -f /run/t630-camera-ready
test -x /usr/local/libexec/t630-camera-capture
test -x /usr/local/bin/t630-gnome-run
owner_home=$(/usr/bin/python3 /usr/local/share/t630/t630_account.py home)

width=720
height=480
frame_bytes=$((width * height * 3 / 2))
android_libraries=/system/lib64:/system/lib64/bootstrap:/apex/com.android.i18n/lib64:/dev/t630-vndk30/lib64:/vendor/lib64:/vendor/lib64/hw
camera=${1:-front}
case "$camera" in
    front)
        camera_id=1
        node_name=t630_front_camera
        node_description=SM-T630_Front_Camera
        image_filter=
        color_filter=(cat)
        ;;
    rear)
        camera_id=0
        node_name=t630_rear_camera
        node_description=SM-T630_Rear_Camera
        # Preserve shadow detail after Samsung's logical rear path scales the
        # already-exposed Y plane into a very low range.
        image_filter='gamma gamma=2.5 !'
        # The HAL's AUTO AWB remains inactive when its required manual rear
        # exposure is used. Apply a modest, deterministic cool correction in
        # userspace without sending fragile preset requests to the HAL.
        test -x /usr/local/sbin/t630-yuv-tune
        color_filter=(/usr/local/sbin/t630-yuv-tune "$width" "$height" 900 1320
            "$owner_home/.config/t630-camera/rear-color")
        ;;
    *) echo "usage: $0 [front|rear]" >&2; exit 2 ;;
esac

env LD_LIBRARY_PATH="$android_libraries" LD_PRELOAD=/dev/t630-android-property-seed.so /usr/local/libexec/t630-camera-capture "$camera_id" - "$width" "$height" 4 0 i420 0 2>"/run/t630-camera-capture-$camera.log" |
    "${color_filter[@]}" |
    /usr/local/bin/t630-gnome-run gst-launch-1.0 -q fdsrc fd=0 do-timestamp=true blocksize="$frame_bytes" ! rawvideoparse format=i420 width="$width" height="$height" framerate=30/1 ! $image_filter queue leaky=downstream max-size-buffers=2 ! pipewiresink mode=provide stream-properties="props,media.class=Video/Source,node.name=$node_name,node.description=$node_description"
