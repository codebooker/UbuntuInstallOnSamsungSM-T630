#!/bin/bash
# Narrow privileged control plane for the SM-T630 camera compatibility stack.
set -euo pipefail

test "$(id -u)" = 0
test "$(cat /etc/t630-install-id)" = SM-T630-T630XXSBDZE3-Ubuntu-v1
test "$#" = 1
case "$1" in
    enable|front) action=front; node=t630_front_camera ;;
    rear) action=rear; node=t630_rear_camera ;;
    disable) action=disable; node= ;;
    *) echo "usage: $0 front|rear|disable" >&2; exit 2 ;;
esac

exec 9>/run/t630-camera-control.lock
if [ "$action" = disable ]; then
    flock -x 9
elif ! flock -n 9; then
    echo 'Camera transition already in progress; retry after it finishes.' >&2
    exit 75
fi

pid_matches() {
    local file=$1 marker=$2 pid cmdline
    test -s "$file" || return 1
    read -r pid <"$file"
    [[ "$pid" =~ ^[0-9]+$ ]] || return 1
    test -r "/proc/$pid/cmdline" || return 1
    cmdline=$( { tr '\0' ' ' <"/proc/$pid/cmdline"; } 2>/dev/null) || return 1
    grep -Fq "$marker" <<<"$cmdline"
}

stop_group() {
    local file=$1 marker=$2 pid attempt candidate group executable
    if pid_matches "$file" "$marker"; then
        read -r pid <"$file"

        if [ "$marker" = /usr/local/sbin/t630-camera-bridge ]; then
            # Stop the downstream consumer first. The capture client ignores
            # SIGPIPE and unwinds through ACameraCaptureSession_close(), which
            # avoids leaving stale CDM/IFE state in Samsung's kernel driver.
            ps -eo pid=,pgid=,exe= | while read -r candidate group executable; do
                if [ "$group" = "$pid" ] &&
                   [ "$executable" = /usr/bin/gst-launch-1.0 ]; then
                    kill -TERM "$candidate" 2>/dev/null || true
                fi
            done
            attempt=0
            while pid_matches "$file" "$marker" && [ "$attempt" -lt 15 ]; do
                attempt=$((attempt + 1))
                sleep .2
            done
        fi

        # Fallback for a bridge that could not unwind, and the normal bounded
        # teardown for the compatibility service stack.
        if ! pid_matches "$file" "$marker"; then
            rm -f "$file"
            return 0
        fi
        kill -TERM -- "-$pid" 2>/dev/null || true
        attempt=0
        while pid_matches "$file" "$marker"; do
            attempt=$((attempt + 1))
            if [ "$attempt" -eq 10 ]; then
                # The bridge holds no user data. Bound a stuck GStreamer/camera
                # teardown, but signal only the still-validated owned group.
                kill -KILL -- "-$pid" 2>/dev/null || true
            fi
            test "$attempt" -lt 16 || return 1
            sleep .5
        done
    fi
    rm -f "$file"
}

if [ "$action" = disable ]; then
    stop_group /run/t630-camera-bridge.pid /usr/local/sbin/t630-camera-bridge
    stop_group /run/t630-camera-stack.pid /usr/local/sbin/t630-camera-stack
    rm -f /run/t630-camera-ready
    exit 0
fi

if ! pid_matches /run/t630-camera-stack.pid /usr/local/sbin/t630-camera-stack ||
   ! pgrep -f '^/vendor/bin/hw/vendor.samsung.hardware.camera.provider@4.0-service_64$' >/dev/null ||
   ! pgrep -f '^/system/bin/cameraserver$' >/dev/null; then
    stop_group /run/t630-camera-bridge.pid /usr/local/sbin/t630-camera-bridge || true
    stop_group /run/t630-camera-stack.pid /usr/local/sbin/t630-camera-stack || true
    /usr/local/sbin/t630-camera-mounts
    rm -f /run/t630-camera-ready
    setsid /usr/local/sbin/t630-camera-stack >/run/t630-camera-stack.out 2>&1 </dev/null 9>&- &
    echo "$!" >/run/t630-camera-stack.pid
fi

attempt=0
until [ -f /run/t630-camera-ready ]; do
    attempt=$((attempt + 1))
    test "$attempt" -lt 55
    sleep 1
done

if pid_matches /run/t630-camera-bridge.pid /usr/local/sbin/t630-camera-bridge &&
   /usr/local/bin/t630-gnome-run pw-cli ls Node 2>/dev/null |
       grep -q "node.name = \"$node\""; then
    exit 0
fi

stop_group /run/t630-camera-bridge.pid /usr/local/sbin/t630-camera-bridge || true
# CameraService and the downstream CDM/IFE driver release the previous client
# asynchronously. A real hardware quiesce also avoids the stock driver's stale
# command-buffer bug during front/rear transitions.
sleep 5

bridge_attempt=0
while [ "$bridge_attempt" -lt 3 ]; do
    bridge_attempt=$((bridge_attempt + 1))
    setsid /usr/local/sbin/t630-camera-bridge "$action" >/run/t630-camera-bridge.log 2>&1 </dev/null 9>&- &
    echo "$!" >/run/t630-camera-bridge.pid

    attempt=0
    while pid_matches /run/t630-camera-bridge.pid /usr/local/sbin/t630-camera-bridge; do
        if /usr/local/bin/t630-gnome-run pw-cli ls Node 2>/dev/null |
                grep -q "node.name = \"$node\""; then
            exit 0
        fi
        attempt=$((attempt + 1))
        [ "$attempt" -lt 20 ] || break
        sleep 1
    done
    stop_group /run/t630-camera-bridge.pid /usr/local/sbin/t630-camera-bridge || true
    sleep 5
done
echo 'Camera source did not appear in PipeWire after three bounded attempts.' >&2
exit 1
