#!/bin/sh
# Called by NetworkManager after Wi-Fi comes up. No boot-image change required.
set -eu
umask 077
exec 9>/run/t630-remote-start.lock
/usr/bin/flock -n 9 || exit 0
test "$(cat /etc/t630-install-id)" = SM-T630-T630XXSBDZE3-Ubuntu-v1
mkdir -p /run/sshd /var/log
chmod 755 /run/sshd /var/log
# Keep the already-verified clean-reboot helper aware of these new services.
# Only replace the exact original helper, or our identical updated helper, in RAM.
host=/proc/1/root
old=9c305c5b345275e9895191f160bc44ed40456addaf8f4e47c16de86b308feb36
previous=796b7aa10e4467d8d31187d95b89d7d0767f6c0c93eb82ebd2cb6633bf64b812
pre_login=9ea0f7c85c2f4e990c83654c29dd3a275468a5acc8f3c96441be9bd91c4aeccd
pre_camera=9146f3cdd0f47460aaba1e062a28bddd1c8cb70fd5aac66e3f40c545d1975437
pre_explicit_reboot=a0ac11cce4915e81138072712fad0385fb50eaddd27d7e91c90cda13f7f4e65c
pre_owner_migration=f50044913572a64d10e018f99b562ea2969bd407f9ffbc9aca9c580cad64fb6a
current=$(/usr/bin/sha256sum "$host/bin/stop-ubuntu" | /usr/bin/cut -d' ' -f1)
updated=$(/usr/bin/sha256sum /usr/local/share/t630/stop-ubuntu | /usr/bin/cut -d' ' -f1)
test "$current" = "$old" || test "$current" = "$previous" || test "$current" = "$pre_login" || test "$current" = "$pre_camera" || test "$current" = "$pre_explicit_reboot" || test "$current" = "$pre_owner_migration" || test "$current" = "$updated"
/usr/bin/install -m 755 /usr/local/share/t630/stop-ubuntu "$host/bin/stop-ubuntu"
/usr/sbin/sshd -t -f /etc/ssh/sshd_config_t630
sshd_pid=$(cat /run/t630-sshd.pid 2>/dev/null || true)
if test -z "$sshd_pid" || ! kill -0 "$sshd_pid" 2>/dev/null || test "$(cat /proc/"$sshd_pid"/comm 2>/dev/null)" != sshd; then
    /usr/sbin/sshd -f /etc/ssh/sshd_config_t630 -E /var/log/t630-sshd.log 9>&-
fi
screen_pid=$(/usr/bin/pgrep -fo '^/usr/bin/python3 /usr/local/libexec/t630-screen$' 2>/dev/null || true)
if test -z "$screen_pid"; then
    /usr/bin/nohup /usr/bin/python3 /usr/local/libexec/t630-screen \
        </dev/null >/run/t630-screen.log 2>&1 9>&- &
    screen_pid=$!
fi

# Keep the remote-start lock until the child has acquired its own lock and
# bound the loopback endpoint. NetworkManager can dispatch several rapid link
# events; without this handshake a second invocation can race Python's process
# rename and launch another server against the same port.
attempt=0
until /usr/bin/curl --fail --silent --max-time 2 http://127.0.0.1:8765/ \
        >/dev/null; do
    if ! kill -0 "$screen_pid" 2>/dev/null; then
        wait "$screen_pid" 2>/dev/null || true
        echo 'Tablet screen service exited before its loopback endpoint was ready.' >&2
        exit 1
    fi
    attempt=$((attempt + 1))
    test "$attempt" -lt 10
    sleep 1
done
