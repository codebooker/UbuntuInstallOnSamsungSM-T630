#!/bin/sh
# Give Waydroid commands launched by GNOME the nested compositor environment.
set -eu

real=/usr/bin/waydroid
test -x "$real"

# Root-side container management must retain its deliberately sparse boot
# environment.  Only owner applications need the nested GNOME socket fixup.
if [ "$(id -u)" = 0 ]; then
    exec "$real" "$@"
fi

test "$(cat /etc/t630-install-id)" = SM-T630-T630XXSBDZE3-Ubuntu-v1
owner=$(cat /etc/t630/owner)
test -n "$owner"
test "$(id -un)" = "$owner"
owner_uid=$(id -u "$owner")
test "$owner_uid" -ge 1000
runtime=/run/user/$owner_uid
test -S "$runtime/t630-gnome-0"
export XDG_RUNTIME_DIR=$runtime
export XDG_SESSION_TYPE=wayland
export WAYLAND_DISPLAY=t630-gnome-0

case "${1:-}:${2:-}" in
    show-full-ui:|app:launch|session:start)
        if [ -e /var/lib/waydroid/t630-software-profile.enabled ]; then
            request=$XDG_RUNTIME_DIR/t630-waydroid-profile.request
            rm -f "$request"
            (umask 077; : >"$request")
        fi
        ;;
esac

exec "$real" "$@"
